generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GithubCache {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}
